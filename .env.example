# Configuration reference only. The application does not automatically load .env.
# Supply values through your terminal, IDE or process manager.
# Required only when initializing a new database: 12+ characters, <=72 UTF-8 bytes.
SUPPORTDESK_DEMO_PASSWORD=

# Optional. Default service port: 8080; loopback binding is kept by the application.
PORT=8080

# Optional MySQL profile. Activate with --spring.profiles.active=mysql.
# Use a dedicated database and account. Do not commit real passwords.
SUPPORTDESK_DB_URL=jdbc:mysql://127.0.0.1:3306/supportdesk?characterEncoding=UTF-8&serverTimezone=UTC
SUPPORTDESK_DB_USERNAME=
SUPPORTDESK_DB_PASSWORD=

# Optional local Ollama. Leave model empty to use the app and retrieval demo without LLM.
SUPPORTDESK_OLLAMA_URL=http://127.0.0.1:11434
SUPPORTDESK_OLLAMA_MODEL=
SUPPORTDESK_THOUGHT_IN_CONTENT=false
